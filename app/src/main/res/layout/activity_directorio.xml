<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/guinda_bg_header"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="4dp">

        <TextView
            android:text="Directorio de Ayuda"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <SearchView
            android:id="@+id/svBuscador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="Buscar institución..."
            android:iconifiedByDefault="false"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="24dp"/> <TextView
        android:text="Filtrar por Categoría:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="24dp"/> <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInstituciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    </LinearLayout>
</LinearLayout>