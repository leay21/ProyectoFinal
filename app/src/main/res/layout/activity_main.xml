<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/guinda_bg_header"
    android:orientation="vertical"
    android:padding="24dp"
    android:elevation="4dp">

    <TextView
        android:text="Participación Ciudadana"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Plataforma de reporte y asistencia"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
</LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:text="Bienvenido. Esta aplicación te permite reportar incidencias en tu comunidad, visualizar zonas de riesgo en el mapa y consultar un directorio de ayuda verificado."
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btnIrReporte"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Crear Nuevo Reporte"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                app:icon="@android:drawable/ic_menu_edit"/>

            <Button
                android:id="@+id/btnIrMapa"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Ver Mapa de Incidencias"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                app:icon="@android:drawable/ic_dialog_map"/>

            <Button
                android:id="@+id/btnIrDirectorio"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Directorio de Instituciones"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                app:icon="@android:drawable/ic_menu_call"/>

            <Button
                android:id="@+id/btnCambiarTema"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Cambiar Tema (Color)"
                android:textSize="16sp"
                app:icon="@android:drawable/ic_menu_view"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>